# Garante quebra de linha LF em arquivos usados pelo Linux.
# Sem isso, um script com CRLF falha no servidor com erro de interpretador.
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf

# Código e configuração do projeto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
