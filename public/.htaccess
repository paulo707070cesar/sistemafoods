# ====================================================================
# SISTEMA FOOD — BAR & RESTAURANTE
# Configuração de Servidor Apache / LiteSpeed (Hostinger Web Hosting)
# Domínio Oficial: https://sistemafoods.xll.com.br/
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirecionar domínio provisório da Hostinger para o domínio oficial
  RewriteCond %{HTTP_HOST} ^sandybrown-crow-226683\.hostingersite\.com$ [NC]
  RewriteRule ^(.*)$ https://sistemafoods.xll.com.br/$1 [R=301,L]

  # 2. Forçar HTTPS em todas as requisições
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. Não reescrever chamadas para a API (pasta /api)
  RewriteRule ^api/ - [L]

  # 4. Se o arquivo ou pasta física existir no servidor, carrega diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. SPA Fallback: redireciona todas as rotas internas para o index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Configuração de CORS (Cross-Origin Resource Sharing)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# ----------------------------------------------------------------------
# Compressão Gzip / Deflate para carregamento ultra-rápido no tablet/celular
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Cache de Arquivos Estáticos (Assets, Imagens, Fontes, JS, CSS)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML e chamadas PHP sem cache para atualização imediata
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # CSS e Javascript compilados com hash
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Imagens e Mídia
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fontes
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Desativar listagem de diretórios
Options -Indexes
