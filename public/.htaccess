# ====================================================================
# SISTEMA FOOD — BAR & RESTAURANTE
# Configuração de Servidor Apache / LiteSpeed (Hostinger Web Hosting)
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Não reescrever chamadas para a API (pasta /api)
  RewriteRule ^api/ - [L]

  # 2. Se o arquivo ou pasta física existir no servidor, carrega diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Fallback: redireciona todas as rotas internas para o index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Configuração de CORS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# ----------------------------------------------------------------------
# Compressão Gzip
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Cache de Assets
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Desativar listagem de diretórios
Options -Indexes
