# Ambiente do servidor web local
NODE_ENV=production
PORT=3000
# Use 0.0.0.0 somente quando outros dispositivos da rede local precisarem acessar o servidor.
HOST=127.0.0.1
TRUST_PROXY=false

# Banco local do servidor. Use caminho absoluto em produção se necessário.
DB_PATH=./data/sistema-food.sqlite

# Criação inicial do usuário administrador (somente na primeira execução).
# Use uma senha forte com pelo menos 12 caracteres e nunca versiona o arquivo .env.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-por-uma-forte

# Deixe true somente quando a aplicação estiver atrás de HTTPS.
SESSION_COOKIE_SECURE=false
